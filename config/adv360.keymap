#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

        // tapdance-tool:begin (360 탭 댄스 생성기가 관리하는 영역)
        td_a: td_a {
            compatible = "zmk,behavior-tap-dance";
            display-name = "a / A";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp A>, <&kp LS(A)>;
        };

        td_b: td_b {
            compatible = "zmk,behavior-tap-dance";
            display-name = "b / B";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp B>, <&kp LS(B)>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            display-name = "c / C";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp C>, <&kp LS(C)>;
        };

        td_d: td_d {
            compatible = "zmk,behavior-tap-dance";
            display-name = "d / D";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp D>, <&kp LS(D)>;
        };

        td_e: td_e {
            compatible = "zmk,behavior-tap-dance";
            display-name = "e / E";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp E>, <&kp LS(E)>;
        };

        td_f: td_f {
            compatible = "zmk,behavior-tap-dance";
            display-name = "f / F";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp F>, <&kp LS(F)>;
        };

        td_g: td_g {
            compatible = "zmk,behavior-tap-dance";
            display-name = "g / G";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp G>, <&kp LS(G)>;
        };

        td_h: td_h {
            compatible = "zmk,behavior-tap-dance";
            display-name = "h / H";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp H>, <&kp LS(H)>;
        };

        td_i: td_i {
            compatible = "zmk,behavior-tap-dance";
            display-name = "i / I";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp I>, <&kp LS(I)>;
        };

        td_j: td_j {
            compatible = "zmk,behavior-tap-dance";
            display-name = "j / J";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp J>, <&kp LS(J)>;
        };

        td_k: td_k {
            compatible = "zmk,behavior-tap-dance";
            display-name = "k / K";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp K>, <&kp LS(K)>;
        };

        td_l: td_l {
            compatible = "zmk,behavior-tap-dance";
            display-name = "l / L";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp L>, <&kp LS(L)>;
        };

        td_m: td_m {
            compatible = "zmk,behavior-tap-dance";
            display-name = "m / M";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp M>, <&kp LS(M)>;
        };

        td_n: td_n {
            compatible = "zmk,behavior-tap-dance";
            display-name = "n / N";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp N>, <&kp LS(N)>;
        };

        td_o: td_o {
            compatible = "zmk,behavior-tap-dance";
            display-name = "o / O";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp O>, <&kp LS(O)>;
        };

        td_p: td_p {
            compatible = "zmk,behavior-tap-dance";
            display-name = "p / P";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp P>, <&kp LS(P)>;
        };

        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            display-name = "q / Q";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp Q>, <&kp LS(Q)>;
        };

        td_r: td_r {
            compatible = "zmk,behavior-tap-dance";
            display-name = "r / R";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp R>, <&kp LS(R)>;
        };

        td_s: td_s {
            compatible = "zmk,behavior-tap-dance";
            display-name = "s / S";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp S>, <&kp LS(S)>;
        };

        td_t: td_t {
            compatible = "zmk,behavior-tap-dance";
            display-name = "t / T";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp T>, <&kp LS(T)>;
        };

        td_u: td_u {
            compatible = "zmk,behavior-tap-dance";
            display-name = "u / U";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp U>, <&kp LS(U)>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            display-name = "v / V";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp V>, <&kp LS(V)>;
        };

        td_w: td_w {
            compatible = "zmk,behavior-tap-dance";
            display-name = "w / W";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp W>, <&kp LS(W)>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            display-name = "x / X";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp X>, <&kp LS(X)>;
        };

        td_y: td_y {
            compatible = "zmk,behavior-tap-dance";
            display-name = "y / Y";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp Y>, <&kp LS(Y)>;
        };

        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            display-name = "z / Z";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp Z>, <&kp LS(Z)>;
        };
        // tapdance-tool:end
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
