#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

        // tapdance-tool:begin (360 탭 댄스 생성기가 관리하는 영역)
        hold_shift: hold_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-unless-interrupted";
            bindings = <&kp>, <&kp>;
        };

        hs_a: hs_a {
            compatible = "zmk,behavior-tap-dance";
            display-name = "a/A";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(A) A>;
        };

        hs_b: hs_b {
            compatible = "zmk,behavior-tap-dance";
            display-name = "b/B";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(B) B>;
        };

        hs_c: hs_c {
            compatible = "zmk,behavior-tap-dance";
            display-name = "c/C";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(C) C>;
        };

        hs_d: hs_d {
            compatible = "zmk,behavior-tap-dance";
            display-name = "d/D";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(D) D>;
        };

        hs_e: hs_e {
            compatible = "zmk,behavior-tap-dance";
            display-name = "e/E";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(E) E>;
        };

        hs_f: hs_f {
            compatible = "zmk,behavior-tap-dance";
            display-name = "f/F";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(F) F>;
        };

        hs_g: hs_g {
            compatible = "zmk,behavior-tap-dance";
            display-name = "g/G";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(G) G>;
        };

        hs_h: hs_h {
            compatible = "zmk,behavior-tap-dance";
            display-name = "h/H";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(H) H>;
        };

        hs_i: hs_i {
            compatible = "zmk,behavior-tap-dance";
            display-name = "i/I";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(I) I>;
        };

        hs_j: hs_j {
            compatible = "zmk,behavior-tap-dance";
            display-name = "j/J";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(J) J>;
        };

        hs_k: hs_k {
            compatible = "zmk,behavior-tap-dance";
            display-name = "k/K";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(K) K>;
        };

        hs_l: hs_l {
            compatible = "zmk,behavior-tap-dance";
            display-name = "l/L";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(L) L>;
        };

        hs_m: hs_m {
            compatible = "zmk,behavior-tap-dance";
            display-name = "m/M";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(M) M>;
        };

        hs_n: hs_n {
            compatible = "zmk,behavior-tap-dance";
            display-name = "n/N";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N) N>;
        };

        hs_o: hs_o {
            compatible = "zmk,behavior-tap-dance";
            display-name = "o/O";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(O) O>;
        };

        hs_p: hs_p {
            compatible = "zmk,behavior-tap-dance";
            display-name = "p/P";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(P) P>;
        };

        hs_q: hs_q {
            compatible = "zmk,behavior-tap-dance";
            display-name = "q/Q";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(Q) Q>;
        };

        hs_r: hs_r {
            compatible = "zmk,behavior-tap-dance";
            display-name = "r/R";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(R) R>;
        };

        hs_s: hs_s {
            compatible = "zmk,behavior-tap-dance";
            display-name = "s/S";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(S) S>;
        };

        hs_t: hs_t {
            compatible = "zmk,behavior-tap-dance";
            display-name = "t/T";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(T) T>;
        };

        hs_u: hs_u {
            compatible = "zmk,behavior-tap-dance";
            display-name = "u/U";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(U) U>;
        };

        hs_v: hs_v {
            compatible = "zmk,behavior-tap-dance";
            display-name = "v/V";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(V) V>;
        };

        hs_w: hs_w {
            compatible = "zmk,behavior-tap-dance";
            display-name = "w/W";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(W) W>;
        };

        hs_x: hs_x {
            compatible = "zmk,behavior-tap-dance";
            display-name = "x/X";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(X) X>;
        };

        hs_y: hs_y {
            compatible = "zmk,behavior-tap-dance";
            display-name = "y/Y";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(Y) Y>;
        };

        hs_z: hs_z {
            compatible = "zmk,behavior-tap-dance";
            display-name = "z/Z";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(Z) Z>;
        };

        hs_n1: hs_n1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "1/!";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N1) N1>;
        };

        hs_n2: hs_n2 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "2/@";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N2) N2>;
        };

        hs_n3: hs_n3 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "3/#";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N3) N3>;
        };

        hs_n4: hs_n4 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "4/$";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N4) N4>;
        };

        hs_n5: hs_n5 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "5/%";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N5) N5>;
        };

        hs_n6: hs_n6 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "6/^";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N6) N6>;
        };

        hs_n7: hs_n7 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "7/&";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N7) N7>;
        };

        hs_n8: hs_n8 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "8/*";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N8) N8>;
        };

        hs_n9: hs_n9 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "9/(";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N9) N9>;
        };

        hs_n0: hs_n0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "0/)";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(N0) N0>;
        };

        hs_grave: hs_grave {
            compatible = "zmk,behavior-tap-dance";
            display-name = "`/~";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(GRAVE) GRAVE>;
        };

        hs_minus: hs_minus {
            compatible = "zmk,behavior-tap-dance";
            display-name = "-/_";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(MINUS) MINUS>;
        };

        hs_equal: hs_equal {
            compatible = "zmk,behavior-tap-dance";
            display-name = "=/+";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(EQUAL) EQUAL>;
        };

        hs_lbkt: hs_lbkt {
            compatible = "zmk,behavior-tap-dance";
            display-name = "[/{";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(LBKT) LBKT>;
        };

        hs_rbkt: hs_rbkt {
            compatible = "zmk,behavior-tap-dance";
            display-name = "]/}";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(RBKT) RBKT>;
        };

        hs_bslh: hs_bslh {
            compatible = "zmk,behavior-tap-dance";
            display-name = "bslh/|";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(BSLH) BSLH>;
        };

        hs_semi: hs_semi {
            compatible = "zmk,behavior-tap-dance";
            display-name = ";/:";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(SEMI) SEMI>;
        };

        hs_sqt: hs_sqt {
            compatible = "zmk,behavior-tap-dance";
            display-name = "qt/dqt";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(SQT) SQT>;
        };

        hs_comma: hs_comma {
            compatible = "zmk,behavior-tap-dance";
            display-name = ",/<";
            #binding-cells = <0>;
            bindings = <&hold_shift LS(COMMA) COMMA>;
        };

        hs_dot: hs_dot {
            compatible = "zmk,behavior-tap-dance";
            display-name = "./>";
